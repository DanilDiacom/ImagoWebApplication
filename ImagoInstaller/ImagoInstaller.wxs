<!--
  Instalátor ImagoAdmin (WiX 5).

  Сборка выпуска: скрипт build-admin-release.ps1 в корне решения
    (публикует ImagoAdmin в ImagoAdmin\bin\Release\publish и собирает ImagoInstaller\bin\x64\Release\ImagoAdminInstaller.msi).
  Версия MSI = версия ImagoAdmin.exe (<Version> в ImagoAdmin.csproj) — поднимать только там.

  UpgradeCode, производитель и папка совпадают с установщиком 1.0.2 (Visual Studio Installer Project),
  поэтому новая версия заменяет старую у клиента, а не ставится второй копией.
  WebView2 (náhled stránek) берётся из Windows 10/11 — в установщик не входит.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
	<?define ProductName="ImagoAdmin"?>
	<?define Manufacturer="ImagoDT s.r.o"?>
	<?define UpgradeCode="8BEC8800-3E3F-4D20-B1EF-5500786F7490"?>
	<?define PublishDir="..\ImagoAdmin\bin\Release\publish\"?>

	<Package Name="$(var.ProductName)"
	         Manufacturer="$(var.Manufacturer)"
	         Version="!(bind.FileVersion.ImagoAdminExe)"
	         UpgradeCode="$(var.UpgradeCode)"
	         Language="1033"
	         Scope="perMachine">

		<!-- Старая версия удаляется целиком перед установкой новой; более новую не понижаем.
		     IgnoreLanguage: у 1.0.0/1.0.2 (Visual Studio Installer) язык продукта 1029, у этого MSI 1033 — без него старые версии не находятся.
		     AllowSameVersionUpgrades: пересобранный MSI той же версии заменяет установленный, а не ставится второй записью. -->
		<MajorUpgrade Schedule="afterInstallInitialize"
		              IgnoreLanguage="yes"
		              AllowSameVersionUpgrades="yes"
		              DowngradeErrorMessage="Je již nainstalována novější verze programu [ProductName]." />
		<MediaTemplate EmbedCab="yes" CompressionLevel="high" />

		<Icon Id="AppIcon.ico" SourceFile="..\ImagoAdmin\favicon.ico" />
		<Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
		<Property Id="ARPNOREPAIR" Value="yes" Secure="yes" />
		<Property Id="ARPNOMODIFY" Value="yes" Secure="yes" />
		<Property Id="ARPURLINFOABOUT" Value="https://imagodt.cz/" />
		<!-- Обновление из программы (у версии 1.0.2 — msiexec /quiet при открытой программе): běžící ImagoAdmin zavřít, ne čekat na restart počítače -->
		<Property Id="MSIRMSHUTDOWN" Value="1" />

		<StandardDirectory Id="ProgramFiles64Folder">
			<Directory Id="ManufacturerFolder" Name="$(var.Manufacturer)">
				<Directory Id="INSTALLFOLDER" Name="$(var.ProductName)" />
			</Directory>
		</StandardDirectory>

		<Feature Id="Main" Title="$(var.ProductName)">
			<ComponentGroupRef Id="AppFiles" />
		</Feature>
	</Package>

	<!-- Файлы программы — всё из папки публикации (новые библиотеки попадают в установщик сами) -->
	<Fragment>
		<ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
			<Component>
				<File Id="ImagoAdminExe" Source="$(var.PublishDir)ImagoAdmin.exe" KeyPath="yes">
					<!-- ярлыки «ImagoAdmin» на рабочем столе и в меню «Пуск» (как у версии 1.0.2) — ставятся и удаляются вместе с программой -->
					<Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="$(var.ProductName)" Description="$(var.ProductName)"
					          WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.ico" Advertise="no" />
					<Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="$(var.ProductName)" Description="$(var.ProductName)"
					          WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.ico" Advertise="no" />
				</File>
			</Component>
			<Files Include="$(var.PublishDir)**">
				<Exclude Files="$(var.PublishDir)ImagoAdmin.exe" />
				<Exclude Files="$(var.PublishDir)**\*.pdb" />
			</Files>
		</ComponentGroup>
	</Fragment>

	<Fragment>
		<StandardDirectory Id="DesktopFolder" />
		<StandardDirectory Id="ProgramMenuFolder" />
	</Fragment>
</Wix>
