@using System.Text.RegularExpressions
@using ImagoLib.Models
@{
    // «Návody k přístrojům» (PageId 46): тексты и видео из базы, редактируются в ImagoAdmin.
    // Видео — блоки Navody_Video{N}_* (Title, Url, Description): добавляются, переставляются и удаляются во вкладке «Bloky».
    // Используется и в /Diacom/Navody, и в /Diacom/DeviceDiacom?id=46 (ссылка из меню).
    var entries = ViewBag.Entries as Dictionary<string, string> ?? new Dictionary<string, string>();
    string T(string key) => entries.TryGetValue(key, out var v) ? v ?? "" : "";
    bool Has(string key) => !string.IsNullOrWhiteSpace(T(key));
    // текст без форматирования — для атрибутов (href, title) и ссылки на YouTube
    string P(string key) => HtmlLite.ToPlainText(T(key));
    var videos = entries.Keys
        .Select(k => Regex.Match(k, @"^Navody_Video(\d+)_"))
        .Where(m => m.Success).Select(m => int.Parse(m.Groups[1].Value))
        .Distinct().OrderBy(n => n).ToList();
}

<partial name="_EntryStyles" model="@("Navody_")" />

<section id="content">
    <div class="inner-content">
        <div class="container">
            <h1 class="page-title" style="margin-top:20px; text-align:center; margin-bottom:20px;" data-key="Navody_Title">@Html.Raw(T("Navody_Title"))</h1>
            @if (Has("Navody_Intro"))
            {
                <p class="text-center" style="margin-bottom:20px;" data-key="Navody_Intro">@Html.Raw(T("Navody_Intro"))</p>
            }

            @foreach (var n in videos)
            {
                var k = $"Navody_Video{n}_";
                var youTubeId = BlockTemplates.YouTubeId(P(k + "Url"));
                <div class="text-center" style="margin-bottom:40px;" data-block="Navody_Video@(n)">
                    @if (Has(k + "Title"))
                    {
                        <h3 style="margin-bottom:15px;" data-key="@(k)Title">@Html.Raw(T(k + "Title"))</h3>
                    }
                    @if (youTubeId != null)
                    {
                        <div style="max-width:560px; margin:0 auto;">
                            <div style="position:relative; padding-top:56.25%;">
                                <iframe style="position:absolute; inset:0; width:100%; height:100%; border:0;"
                                        src="https://www.youtube.com/embed/@youTubeId"
                                        title="@P(k + "Title")"
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                        allowfullscreen loading="lazy"></iframe>
                            </div>
                        </div>
                    }
                    else if (Has(k + "Url"))
                    {
                        @* ссылка не на YouTube — показываем обычной ссылкой *@
                        <p><a href="@P(k + "Url")" target="_blank" rel="noopener">@Html.Raw(T(k + "Url"))</a></p>
                    }
                    @if (Has(k + "Description"))
                    {
                        <p style="max-width:700px; margin:15px auto 0;" data-key="@(k)Description">@Html.Raw(T(k + "Description"))</p>
                    }
                </div>
            }
        </div>
    </div>
</section>
